{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node", "vite/client"],
    "noEmit": true,
    "noEmitOnError": false,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true
  },
  "include": ["server/**/*.test.ts", "src/**/*.test.ts"],
  "exclude": ["dist", "node_modules"]
}
