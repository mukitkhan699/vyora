{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "noEmit": false,
    "noEmitOnError": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": ".",
    "outDir": "./dist"
  },
  "include": ["server.ts", "server/**/*.ts"],
  "exclude": ["dist", "node_modules", "server/**/*.test.ts"]
}
