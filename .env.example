# ---------------------------------------------------------------------------
# VYORA runtime configuration
# Copy to `.env` and adjust for your deployment. All values are optional.
# ---------------------------------------------------------------------------

# Network
PORT=3000
HOST=0.0.0.0
# Public URL used in verification and password-reset emails.
APP_BASE_URL="http://127.0.0.1:3000"
# Set when running behind a reverse proxy.
# PUBLIC_HOST="vyora.example.com"
# TRUST_PROXY=1
# TRUST_PROXY_HOPS=1
# TRUSTED_PROXY_ADDRESSES="127.0.0.1,::1"

# Application branding
APP_NAME="VYORA"
APP_TAGLINE="Global Transmission Network"
APP_DESCRIPTION="A real-time social relay for broadcasting ideas, following operators, and moving information across the network."
DEFAULT_THEME="dark" # dark | dim | light
DEFAULT_ACCENT_COLOR="cyan" # cyan | violet | amber | emerald | coral | blue

# Content & features
MAX_POST_LENGTH=280
ENABLE_POLLS=true
ENABLE_BOOKMARKS=true
ENABLE_DIRECT_MESSAGES=true
ALLOW_MEDIA_UPLOADS=true

# Multi-CDN delivery
CDN_URLS="https://images.unsplash.com,https://picsum.photos,https://avatars.githubusercontent.com"

# Authentication (SQLite-backed, no external database required)
AUTH_DATABASE_PATH="./data/auth.db"
REQUIRE_EMAIL_VERIFICATION=false
# COOKIE_SECURE=true # force Secure cookies when TLS terminates before Node
# SCRYPT_MAX_CONCURRENT=4

# SMTP for verification and password-reset email.
# Leave blank in development; links are printed to the server console.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="VYORA <no-reply@example.com>"
SMTP_ALLOW_INSECURE=false
SMTP_TIMEOUT_MS=15000
SMTP_EHLO_NAME="localhost"
