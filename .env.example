# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Application Branding & Display
APP_NAME="X"
APP_DESCRIPTION="The global town square"
DEFAULT_THEME="dark" # dark | dim | light
DEFAULT_ACCENT_COLOR="blue" # blue | yellow | pink | purple | orange | green

# Content & Feature Configuration
MAX_POST_LENGTH=280
ENABLE_POLLS=true
ENABLE_BOOKMARKS=true
ENABLE_DIRECT_MESSAGES=true
ALLOW_MEDIA_UPLOADS=true

# Multi-CDN Configuration (comma-separated URLs).
# The client and server will cycle through these CDNs with automatic fallback.
# Add your CDNs here (e.g. Cloudflare, AWS CloudFront, Fastly, BunnyCDN, Unsplash, etc.)
CDN_URLS="https://images.unsplash.com,https://picsum.photos,https://avatars.githubusercontent.com"
VITE_CDN_URLS="https://images.unsplash.com,https://picsum.photos,https://avatars.githubusercontent.com"

# PostgreSQL Database Configuration
# Supported options: "auto" (attempts Postgres if config exists, falls back cleanly to resilient store), "postgres", "memory"
DATABASE_TYPE="auto"
# Direct connection string (e.g., postgresql://username:password@localhost:5432/x_database)
DATABASE_URL=""
# Or individual credentials:
SQL_HOST="localhost"
SQL_PORT=5432
SQL_USER="postgres"
SQL_PASSWORD=""
SQL_DB_NAME="x_social"
SQL_SSL=false

