# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server-only Neon PostgreSQL and private Backblaze B2 credentials.
# Never use these values in VITE_* variables or frontend code.
DATABASE_URL=
# Direct, unpooled Neon endpoint for Socket.IO LISTEN/NOTIFY and database migrations.
DATABASE_URL_DIRECT=
B2_ENDPOINT=
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=

# LiveKit Calling Configuration (server-only).
# These values are placeholders; replace them with credentials from your LiveKit project.
# Never expose these values through VITE_* variables or client-side code.
LIVEKIT_API_KEY=replace_with_livekit_api_key
LIVEKIT_API_SECRET=replace_with_livekit_api_secret_at_least_32_characters
LIVEKIT_URL=wss://your-project.livekit.cloud

# Optional realtime outbox tuning (bounded values; defaults are suitable for most deployments).
# REALTIME_OUTBOX_BATCH_SIZE=20
# REALTIME_OUTBOX_LEASE_MS=30000
# REALTIME_OUTBOX_POLL_INTERVAL_MS=1000

# Admin Dashboard Configuration
# SUPER_ADMIN_PUBLIC_ID: The public_id of an existing Zunari user to bootstrap as the first Super Admin.
# Must reference a user that already exists in zunari_users (format: user_auth_<id> or demo IDs like user_mukit).
# Set this once during initial deployment to create the first admin account.
# Do not include this in version control with a real value.
# SUPER_ADMIN_PUBLIC_ID=user_auth_1

# ADMIN_ORIGIN: The origin of the separate admin frontend (e.g., https://admin-zunari.duckdns.org).
# Used for HTTP CORS and Socket.IO CORS to allow cross-origin requests from the admin frontend.
# Must be set when deploying the admin frontend on a separate hostname.
# ADMIN_ORIGIN=https://admin-zunari.duckdns.org

# VITE_ADMIN_API_URL: The backend API base URL for the separate admin frontend.
# Required when deploying the admin frontend on a separate hostname (e.g., admin-zunari.duckdns.org).
# Should point to the backend API origin (e.g., https://zunari.duckdns.org).
# Without this, the admin frontend will incorrectly use its own origin for API calls.
# VITE_ADMIN_API_URL=https://zunari.duckdns.org

# TRUST_PROXY_HOPS: Number of trusted reverse proxies that append to X-Forwarded-For.
# Leave unset (0) unless Zunari is behind a controlled proxy. When 0, report IP rate
# limiting uses only the TCP peer address, which avoids trusting spoofable headers.
# TRUST_PROXY_HOPS=1

# RATE_LIMIT_HMAC_SECRET: Secret key for HMAC-SHA256 hashing of IP addresses in rate limit counters.
# Must be at least 32 characters. Generate with: openssl rand -hex 32
# RATE_LIMIT_HMAC_SECRET=your-secret-here
