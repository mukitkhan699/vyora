{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile on the X platform",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "User ID" },
        "name": { "type": "string", "maxLength": 50, "description": "Display name" },
        "username": { "type": "string", "pattern": "^[a-zA-Z0-9_]{1,15}$", "description": "Unique @handle" },
        "avatarUrl": { "type": "string", "maxLength": 500, "description": "Avatar image URL or CDN path" },
        "bannerUrl": { "type": "string", "maxLength": 500, "description": "Banner cover image URL" },
        "bio": { "type": "string", "maxLength": 160, "description": "User bio description" },
        "location": { "type": "string", "maxLength": 100, "description": "User location" },
        "website": { "type": "string", "maxLength": 100, "description": "User website link" },
        "verified": { "type": "boolean", "description": "Blue checkmark verified badge" },
        "followersCount": { "type": "number", "description": "Number of followers" },
        "followingCount": { "type": "number", "description": "Number of following users" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["uid", "name", "username"]
    },
    "Post": {
      "title": "Post",
      "description": "Post / Tweet published by a user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Post ID" },
        "authorId": { "type": "string", "description": "Author UID" },
        "content": { "type": "string", "maxLength": 280, "description": "Text content of post" },
        "mediaUrls": { "type": "array", "description": "Array of attached image/video CDN links" },
        "replyToId": { "type": "string", "description": "Parent post ID if this is a reply" },
        "quotePostId": { "type": "string", "description": "Quoted post ID if quote post" },
        "likesCount": { "type": "number", "description": "Total likes" },
        "repostsCount": { "type": "number", "description": "Total reposts" },
        "repliesCount": { "type": "number", "description": "Total replies" },
        "viewsCount": { "type": "number", "description": "Total impression views" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Publication timestamp" }
      },
      "required": ["id", "authorId", "content", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Public user profile information"
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Public posts published on the platform"
    }
  }
}
