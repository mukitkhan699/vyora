{
  "name": "react-example",
  "version": "0.0.0",
  "private": true,
  "description": "<div align=\"center\"> <img width=\"1200\" height=\"475\" alt=\"GHBanner\" src=\"https://ai.google.dev/static/site-assets/images/share-ais-513315318.png\" /> </div>",
  "homepage": "https://github.com/mukitkhan699/vyora#readme",
  "bugs": {
    "url": "https://github.com/mukitkhan699/vyora/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mukitkhan699/vyora.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && tsc -p tsconfig.server.json && node scripts/copy-migrations.mjs",
    "build:admin": "vite build --config vite.config.admin.ts",
    "start": "node dist/server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "test": "node --experimental-test-module-mocks --import tsx --test server/admin-integration.test.ts server/report-rate-limit.test.ts server/audit-export.test.ts server/audit-export-stream.test.ts server/reports-moderation.test.ts server/db/migrate.test.ts server/db/startup-migration.test.ts server/storage/b2.test.ts server/profile-validation.test.ts server/post-publishing.test.ts server/post-media-limit.test.ts server/messaging-security.test.ts server/event-outbox.test.ts server/messaging-outbox.test.ts server/messaging-foundation.test.ts server/conversation-membership-lock.test.ts server/legacy-messaging-retirement.test.ts server/realtime-adapter.test.ts src/utils/mediaValidation.test.ts src/utils/postMedia.test.ts src/utils/profileForm.test.ts src/utils/messaging.test.ts",
    "test:postgres": "RUN_POSTGRES_INTEGRATION=1 node --import tsx --test server/reports-postgres.integration.test.ts server/realtime-outbox-postgres.integration.test.ts server/realtime-adapter-postgres.integration.test.ts",
    "test:migrations:postgres": "RUN_POSTGRES_INTEGRATION=1 node --import tsx --test server/db/migrate-postgres.integration.test.ts",
    "db:migrate": "tsx server/db/run-migrations.ts",
    "db:migrate:dist": "node dist/server/db/run-migrations.js",
    "db:import-sqlite": "tsx server/db/import-sqlite.ts",
    "db:seed-demo": "tsx server/db/seed-demo.ts",
    "build:android": "VITE_ANDROID_BUILD=true vite build --config vite.config.android.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1163.0",
    "@aws-sdk/s3-request-presigner": "^3.1163.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@google/genai": "^2.4.0",
    "@socket.io/postgres-adapter": "0.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.26",
    "@vitejs/plugin-react": "^6.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/cors": "^2.8.17",
    "@types/dom-mediacapture-record": "^1.0.22",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
